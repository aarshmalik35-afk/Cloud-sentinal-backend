{
  "s3_buckets": [
    {
      "name": "demo-public-risk",
      "block_public_access": false
    },
    {
      "name": "demo-protected",
      "block_public_access": true
    },
    {
      "name": "demo-needs-review"
    }
  ],
  "security_groups": [
    {
      "name": "demo-web-sg",
      "inbound_rules": [
        {
          "protocol": "tcp",
          "port": 22,
          "cidrs": [
            "0.0.0.0/0"
          ]
        },
        {
          "protocol": "tcp",
          "port": 443,
          "cidrs": [
            "0.0.0.0/0"
          ]
        }
      ]
    },
    {
      "name": "demo-admin-sg",
      "inbound_rules": [
        {
          "protocol": "tcp",
          "port": 22,
          "cidrs": [
            "203.0.113.0/24"
          ]
        }
      ]
    }
  ],
  "iam_policies": [
    {
      "name": "demo-admin-policy",
      "actions": [
        "*"
      ],
      "resources": [
        "*"
      ]
    },
    {
      "name": "demo-read-only-policy",
      "actions": [
        "s3:GetObject"
      ],
      "resources": [
        "arn:aws:s3:::demo/*"
      ]
    }
  ]
}
