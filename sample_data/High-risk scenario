{
  "s3_buckets": [
    {
      "name": "customs-invoices-demo",
      "block_public_access": {
        "block_public_acls": true,
        "ignore_public_acls": true,
        "block_public_policy": true,
        "restrict_public_buckets": true
      },
      "public": false,
      "encryption_enabled": true,
      "versioning_enabled": true,
      "logging_enabled": true
    },
    {
      "name": "legacy-archive-demo",
      "block_public_access": {
        "block_public_acls": false,
        "ignore_public_acls": true,
        "block_public_policy": false,
        "restrict_public_buckets": false
      },
      "public": true,
      "encryption_enabled": false,
      "versioning_enabled": false,
      "logging_enabled": false
    }
  ],
  "security_groups": [
    {
      "id": "sg-demo-admin",
      "ingress": [
        {
          "port": 22,
          "protocol": "tcp",
          "source": "0.0.0.0/0"
        }
      ]
    },
    {
      "id": "sg-demo-rdp",
      "ingress": [
        {
          "port": 3389,
          "protocol": "tcp",
          "source": "::/0"
        }
      ]
    },
    {
      "id": "sg-demo-web",
      "ingress": [
        {
          "port": 443,
          "protocol": "tcp",
          "source": "0.0.0.0/0"
        }
      ]
    }
  ],
  "iam_policies": [
    {
      "name": "DemoAdminPolicy",
      "statements": [
        {
          "action": "*",
          "resource": "*"
        }
      ]
    },
    {
      "name": "InvoiceReaderPolicy",
      "statements": [
        {
          "action": [
            "s3:GetObject"
          ],
          "resource": [
            "arn:aws:s3:::customs-invoices-demo/*"
          ]
        }
      ]
    }
  ],
  "account_settings": {
    "cloudtrail_enabled": false,
    "security_monitoring_alarm_configured": false
  }
}
